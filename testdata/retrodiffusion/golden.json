{
  "openapi": "3.1.0",
  "info": {
    "title": "API",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "https://api.retrodiffusion.ai"
    }
  ],
  "paths": {
    "/v1/styles/selector": {
      "get": {
        "operationId": "ListV1StylesSelector",
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "rd_pro"
            }
          },
          {
            "name": "X-Rd-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "styles": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "prompt_style": {
                            "type": "string",
                            "example": "rd_animation__8_dir_rotation"
                          },
                          "name": {
                            "type": "string",
                            "example": "8 Direction Rotation"
                          },
                          "description": {
                            "type": "string",
                            "example": "Create 8 direction rotations of anything."
                          },
                          "group_id": {
                            "type": "string",
                            "example": "RD Animation"
                          },
                          "required_model": {
                            "type": "string",
                            "example": "rd_pro"
                          },
                          "required_tab": {
                            "type": "string",
                            "example": "tab:animation"
                          },
                          "min_width": {
                            "type": "integer",
                            "example": 80
                          },
                          "max_width": {
                            "type": "integer",
                            "example": 80
                          },
                          "min_height": {
                            "type": "integer",
                            "example": 80
                          },
                          "max_height": {
                            "type": "integer",
                            "example": 80
                          },
                          "max_number_of_images": {
                            "type": "integer",
                            "example": 1
                          },
                          "require_input_image": {
                            "type": "boolean",
                            "example": null
                          },
                          "supports_reference_images": {
                            "type": "boolean"
                          },
                          "example_prompt": {
                            "type": "string",
                            "example": "An orange cat playing with a blue ball of yarn"
                          }
                        },
                        "required": [
                          "prompt_style",
                          "name",
                          "description",
                          "group_id",
                          "required_model",
                          "required_tab",
                          "min_width",
                          "max_width",
                          "min_height",
                          "max_height",
                          "max_number_of_images",
                          "require_input_image",
                          "supports_reference_images",
                          "example_prompt"
                        ]
                      }
                    },
                    "models": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "rd_pro"
                      }
                    },
                    "tabs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "tab:advanced-animation"
                      }
                    }
                  },
                  "required": [
                    "styles",
                    "models",
                    "tabs"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/inferences": {
      "post": {
        "operationId": "PostV1Inferences",
        "parameters": [
          {
            "name": "X-Rd-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "example": "security officer (a soldier). A 34-year-old male human. Lean and wiry, with a posture that suggests he's always expecting something to break. He wears the standard grey-blue security fatigues, kept meticulously clean despite the dust of the colony. A thin, jagged scar running through his left eyebrow. He has a habit of clicking his tongue when he's impatient."
                  },
                  "prompt_style": {
                    "type": "string",
                    "example": "rd_pro__topdown"
                  },
                  "width": {
                    "type": "integer",
                    "example": 128
                  },
                  "height": {
                    "type": "integer",
                    "example": 128
                  },
                  "num_images": {
                    "type": "integer",
                    "example": 1
                  },
                  "remove_bg": {
                    "type": "boolean"
                  },
                  "tile_x": {
                    "type": "boolean"
                  },
                  "tile_y": {
                    "type": "boolean"
                  },
                  "return_spritesheet": {
                    "type": "boolean"
                  },
                  "bypass_prompt_expansion": {
                    "type": "boolean"
                  },
                  "include_downloadable_data": {
                    "type": "boolean"
                  },
                  "check_cost": {
                    "type": "boolean"
                  },
                  "async": {
                    "type": "boolean"
                  },
                  "upload_outputs": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "prompt",
                  "prompt_style",
                  "width",
                  "height",
                  "num_images",
                  "remove_bg",
                  "tile_x",
                  "tile_y",
                  "return_spritesheet",
                  "bypass_prompt_expansion",
                  "include_downloadable_data",
                  "check_cost",
                  "async",
                  "upload_outputs"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "created_at": {
                      "type": "integer",
                      "example": 1788096424
                    },
                    "credit_cost": {
                      "type": "integer",
                      "example": 0
                    },
                    "balance_cost": {
                      "type": "number",
                      "format": "double",
                      "example": 0.18
                    },
                    "output_images": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "example": null
                      }
                    },
                    "base64_images": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "example": null
                      }
                    },
                    "output_urls": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "example": null
                      }
                    },
                    "model": {
                      "type": "string",
                      "example": "check_cost"
                    },
                    "remaining_credits": {
                      "type": "integer",
                      "example": 0
                    },
                    "remaining_balance": {
                      "type": "number",
                      "format": "double",
                      "example": 0.5
                    }
                  },
                  "required": [
                    "created_at",
                    "credit_cost",
                    "balance_cost",
                    "output_images",
                    "base64_images",
                    "output_urls",
                    "model",
                    "remaining_credits",
                    "remaining_balance"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}